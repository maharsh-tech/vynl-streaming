# Server
PORT=8000
BASE_URL=http://localhost:8000

# Track resolution
ITUNES_SEARCH_COUNTRY=US
ITUNES_SEARCH_LIMIT=5

# Download
APL_MAX_RETRIES=3
DOWNLOAD_TIMEOUT=120

# Telegram — Phase 3+ (required for /ingest and /stream)
API_ID=
API_HASH=
BOT_TOKEN=
STORAGE_CHANNEL_ID=-100xxxxxxxxxx

# MongoDB — Phase 3+ (required for /ingest and /stream)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vynl_audio

# Stream token TTL in seconds (default 2 hours)
STREAM_TOKEN_TTL=7200
